    "icons": "node scripts/render-brand-icons.mjs",
    "store-assets": "node scripts/render-store-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "linkedom": "^0.18.13",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@iconify-icons/lucide": "^2.0.18",
    "@iconify-icons/simple-icons": "^2.0.6"
